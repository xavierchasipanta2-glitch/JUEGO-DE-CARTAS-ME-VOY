rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // =========================================================================
    // PERFILES DE USUARIO
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // =========================================================================
    // MESAS DE JUEGO («ME VOY»)
    // =========================================================================
    match /tables/{tableId} {
      // Lectura permitida para sincronización en tiempo real y conexión por código
      allow read: if true;

      // Creación de mesas con hasta 4 participantes
      allow create: if true;

      // Actualizaciones de partida, liquidación, recargas y transferencias
      allow update: if true;

      // Prohibido eliminar mesas con historial contable
      allow delete: if false;

      match /audit_logs/{logId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }
  }
}
